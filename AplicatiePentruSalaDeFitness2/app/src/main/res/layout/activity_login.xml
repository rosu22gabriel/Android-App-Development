<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    tools:context=".LoginActivity">

    <ImageView
        android:id="@+id/user_icon_id"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/baseline_account_circle_24"
        android:contentDescription="@string/content_description_user_icon">
    </ImageView>

    <EditText
        android:id="@+id/email_input_id"
        android:layout_height="48dp"
        android:layout_width="350dp"
        android:layout_marginTop="100dp"
        android:layout_gravity="center"
        android:layout_marginBottom="10dp"
        android:inputType="textEmailAddress"
        android:hint="@string/email_input_string">
    </EditText>

    <EditText
        android:id="@id/pincode_input_id"
        android:layout_width="350dp"
        android:layout_height="48dp"
        android:inputType="numberPassword"
        android:layout_gravity="center"
        android:hint="@string/pincode_input_hint_text">
    </EditText>

    <Button
        android:id="@id/log_in_button_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/log_in_button_text"
        android:layout_marginTop="20dp">
    </Button>

    <Button
        android:id="@+id/become_a_member_button_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/become_a_member_button_text">
    </Button>

</LinearLayout>