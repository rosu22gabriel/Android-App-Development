<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.rosugabriel.RegisterActivity"
    android:orientation="vertical"
    android:gravity="center">

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pagina_de_inscriere_string"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:layout_marginBottom="100dp">
        </TextView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/email_input_label_id"
            android:text="@string/email_input_label_string"
            android:gravity="center">
        </TextView>

        <EditText
            android:id="@+id/email_input_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:hint="@string/email_input_hint_text"
            android:gravity="center">
        </EditText>


        <TextView
            android:id="@id/phone_number_input_label_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/email_input_id"
            android:text="@string/phone_number_input_label_text"
            android:gravity="center">
        </TextView>

        <EditText
            android:id="@+id/phone_number_input_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone|number"
            android:hint="@string/phone_number_input_hint_text"
            android:gravity="center">
        </EditText>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/email_input_id"
            android:text="@string/first_name_input_label_text"
            android:gravity="center">
        </TextView>

        <EditText
            android:id="@+id/first_name_input_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:hint="@string/first_name_input_hint_text"
            android:gravity="center">
        </EditText>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/last_name_input_id"
            android:text="@string/last_name_input_label_text"
            android:gravity="center">
        </TextView>

        <EditText
            android:id="@+id/last_name_input_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:hint="@string/last_name_input_hint_text"
            android:gravity="center">
        </EditText>

        <Button
            android:id="@id/inregistreaza_te_button_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/inregistreaza_te_button_text">
        </Button>

    </LinearLayout>


</LinearLayout>